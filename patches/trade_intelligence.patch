-        function createSqrtScale(values, minimum, maximum) {
-            const numeric = values.map((value) => Number(value)).filter((value) => Number.isFinite(value) && value > 0);
-            if (!numeric.length) return () => (minimum + maximum) / 2;
-            const domainMin = d3.min(numeric);
-            const domainMax = d3.max(numeric);
-            if (domainMin === domainMax) return () => (minimum + maximum) / 2;
-            return d3.scaleSqrt().domain([domainMin, domainMax]).range([minimum, maximum]);
-        }
