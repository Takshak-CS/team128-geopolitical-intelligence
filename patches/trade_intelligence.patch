+* { box-sizing: border-box; }
+html, body { margin: 0; }
+body { font-family: var(--font); color: var(--text); background: var(--bg); font-size: 14px; line-height: 1.5; min-height: 100vh; }
+/* The same soft glows the main site uses, in the Trade card's greens. */
+body::before { content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
+  background: var(--glow); }
+button, input, select { font: inherit; color: inherit; }
+.hidden { display: none !important; }
+.muted { color: var(--muted); }
+.mono { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; }
+::selection { background: var(--selection); }
+* { scrollbar-color: var(--scroll) transparent; }
+
+/* ---------- top bar ---------- */
+.topbar { background: var(--topbar-bg); border-bottom: 1px solid var(--line); backdrop-filter: blur(10px); position: relative; }
+.topbar::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: linear-gradient(90deg, transparent, var(--accent-line), transparent); }
+.topbar-inner { max-width: 1440px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
+.brand { display: flex; align-items: center; gap: 12px; }
+.logo { width: 36px; height: 36px; border-radius: 10px; background: var(--grad); color: var(--on-accent); display: grid; place-items: center; font-weight: 800; letter-spacing: -0.02em; box-shadow: 0 0 18px var(--accent-glow); }
+.brand h1 { margin: 0; font-size: 17px; letter-spacing: -0.01em; }
+.brand p { margin: 0; color: var(--muted); font-size: 12.5px; }
+.conn { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); color: var(--muted); font-size: 12.5px; font-weight: 600; }
+.conn .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--soft); }
+.conn.ok .dot { background: var(--good); box-shadow: 0 0 8px var(--good); }
+.conn.bad .dot { background: var(--bad); }
+
+/* ---------- layout ---------- */
+.shell { max-width: 1440px; margin: 0 auto; padding: 20px 24px 40px; display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 20px; align-items: start; }
+.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
+.panel { position: sticky; top: 16px; padding: 18px; max-height: calc(100vh - 32px); overflow: auto; }
+.results { display: grid; gap: 16px; min-width: 0; }
+
+/* ---------- control panel ---------- */
+.step { margin-bottom: 18px; }
+.step-title { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
+.step-title .n { width: 20px; height: 20px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line); display: grid; place-items: center; font-size: 11px; }
+.analyses { display: grid; gap: 6px; }
+.analysis { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; text-align: left; padding: 9px 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2); cursor: pointer; transition: border-color .12s, background .12s; }
+.analysis:hover { border-color: var(--line-strong); background: var(--hover-bg); }
+.analysis[aria-checked="true"] { border-color: var(--accent-line); background: var(--selected-bg); box-shadow: 0 0 0 1px var(--accent-soft) inset; }
+.analysis .ic { font-size: 15px; line-height: 20px; text-align: center; color: var(--accent); }
+.analysis b { display: block; font-size: 13.5px; }
+.analysis span { display: block; color: var(--muted); font-size: 12px; line-height: 1.35; }
+.analysis .new { display: inline-block; margin-left: 6px; padding: 0 6px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 10.5px; font-weight: 700; vertical-align: 1px; }
+.field { display: grid; gap: 5px; margin-bottom: 12px; }
+.field label { font-size: 12.5px; font-weight: 600; }
+.field .hint { color: var(--muted); font-size: 12px; }
+.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+input[type="text"], input[type="number"], input[type="search"], select { width: 100%; height: 36px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--input-bg); color: var(--text); outline: none; transition: border-color .12s, box-shadow .12s; }
+input::placeholder { color: var(--soft); }
+select option, select optgroup { font-size: 14px; background: var(--surface-solid); color: var(--text); }
+input:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--focus-ring); }
+input:disabled, select:disabled { background: var(--input-disabled); color: var(--soft); cursor: not-allowed; }
+input[type="range"] { width: 100%; accent-color: var(--accent-strong); }
+.range-meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
+.range-meta b { color: var(--accent); }
+.segmented { display: inline-flex; padding: 3px; border-radius: 9px; background: var(--input-bg); border: 1px solid var(--line); gap: 2px; width: 100%; }
+.segmented button { flex: 1; border: 0; background: transparent; height: 28px; border-radius: 7px; font-size: 12.5px; font-weight: 600; color: var(--muted); cursor: pointer; }
+.segmented button[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent-ink); box-shadow: 0 0 0 1px var(--accent-line) inset; }
+.segmented button:disabled { opacity: .4; cursor: not-allowed; }
+details.more { border-top: 1px dashed var(--line-strong); padding-top: 10px; margin-top: 4px; }
+details.more summary { cursor: pointer; color: var(--muted); font-size: 12.5px; font-weight: 600; margin-bottom: 8px; }
+.run { width: 100%; height: 42px; border: 0; border-radius: 10px; background: var(--grad); color: var(--on-accent); font-weight: 750; font-size: 14px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 8px 24px var(--accent-glow); transition: filter .12s, box-shadow .12s; }
+.run:hover { filter: brightness(1.08); box-shadow: 0 10px 30px var(--accent-glow); }
+.run:disabled { opacity: .7; cursor: wait; }
+.spinner { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--accent-line); border-top-color: var(--on-accent); animation: spin .8s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.settings { margin-top: 14px; font-size: 12px; color: var(--muted); }
+.settings summary { cursor: pointer; }
+.note { padding: 8px 10px; border-radius: 8px; background: var(--surface-2); border: 1px solid var(--line); color: var(--muted); font-size: 12px; }
+
+/* product picker */
+.picker { position: relative; }
