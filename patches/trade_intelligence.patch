+        columns=["year", "sector", "exports"],
+        filters=[("sector", "==", str(sector))],
+    )
+    series = totals.groupby("year")["exports"].sum().sort_index()
+    return [{"year": int(year), "value": float(value)} for year, value in series.items()]
