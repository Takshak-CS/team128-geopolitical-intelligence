# Environments and tooling
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.run/
/.env
node_modules/
dist/

# Data (see docs/DATA.md) - never committed. The one exception is the trade
# parquet cache (services/trade_intelligence/cache/, 58 MB), which is committed
# so the trade agent works on a fresh clone without the 8 GB BACI dataset. Its
# product-level store (cache/products/, 345 MB) is not: it ships with the deploy
# data bundle, and the agent works without it, minus product filtering.
services/trade_intelligence/dataset/
services/trade_intelligence/cache/products/
services/policy_stance/data/
services/policy_stance/outputs/
services/event_summarization/data/*
!services/event_summarization/data/.cache_index.json
services/event_summarization/media/briefings/*

# Captured fixtures are small and committed; anything else under tests stays local
orchestrator/tests/fixtures/*.tmp

# Machine-specific editor/preview config
.claude/

# Deployment secrets and generated config
deploy/.auth
deploy/Caddyfile

# Visitor reviews stored by a local orchestrator (app/reviews.py)
orchestrator/data/
