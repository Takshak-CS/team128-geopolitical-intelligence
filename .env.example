# Copy to .env (docker compose reads it) or export in your shell.

# Agent addresses for the orchestrator (defaults shown).
SOFT_POWER_URL=http://127.0.0.1:8101
POLICY_STANCE_URL=http://127.0.0.1:8102
TRADE_URL=http://127.0.0.1:8103
EVENTS_URL=http://127.0.0.1:8104

# Per-agent timeouts in seconds; set *_ENABLED=0 to leave an agent out.
EVENTS_TIMEOUT=120
# EVENTS_ENABLED=0

# Drill-through links shown in the UI for each module's own dashboard.
SOFT_POWER_DASHBOARD_URL=http://localhost:5174
POLICY_STANCE_DASHBOARD_URL=http://localhost:5175
TRADE_DASHBOARD_URL=http://localhost:8080/?api=http://127.0.0.1:8103
EVENTS_DASHBOARD_URL=http://localhost:5176

# Only the Events module's optional article verification uses this.
GEMINI_API_KEY=
